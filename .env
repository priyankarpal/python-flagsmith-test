
# Required: Your Flagsmith Server-Side Environment Key
# Get this from your Flagsmith project settings -> Environment -> Server-side SDK Key
FLAGSMITH_SERVER_SIDE_ENVIRONMENT_KEY=ser.dLHvEU8dpB8cMmVLTYTGpq

# Optional: Enable local evaluation mode (requires server-side key)
# When true, SDK evaluates flags locally using cached environment document
# When false (default), SDK makes API calls for each flag evaluation
FLAGSMITH_ENABLE_LOCAL_EVALUATION=true

# Optional: Custom Flagsmith API URL (for self-hosted instances)
# FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# Optional: Request timeout in seconds (default: 10)
# FLAGSMITH_REQUEST_TIMEOUT_SECONDS=10

# Optional: Environment document refresh interval in seconds for local evaluation (default: 60)
# FLAGSMITH_ENV_REFRESH_INTERVAL_SECONDS=60

# Optional: Enable flag analytics (default: false)
# FLAGSMITH_ENABLE_ANALYTICS=false

# Optional: Custom headers as JSON string
# FLAGSMITH_CUSTOM_HEADERS={"X-Request-ID": "abc123"}

# Optional: Offline mode with local environment document (default: false)
# FLAGSMITH_OFFLINE_MODE=false
# FLAGSMITH_ENVIRONMENT_DOCUMENT_PATH=/path/to/environment.json